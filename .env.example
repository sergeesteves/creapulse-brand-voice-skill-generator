# --- Obligatoire ---
SECRET_KEY=change-me-64-random-chars            # signe la session membre (python -c "import secrets;print(secrets.token_urlsafe(48))")
CRAWL4AI_TOKEN=                                  # = CRAWL4AI_API_TOKEN du crawl4ai Coolify
LLM_API_KEY=                                     # clé API omniroute (dashboard omniroute.creapulse.fr)
ROOT_PATH=/outils/voix-de-marque                 # préfixe de chemin si servi sous un sous-dossier ; vide si domaine dédié

# --- Store (SQLite sur volume persistant en prod ; Postgres possible) ---
DATABASE_URL=sqlite:////data/voice-skill.db
# DATABASE_URL=postgresql://user:pass@host:5432/voice_skill

# --- Services réutilisés ---
CRAWL4AI_URL=https://crawl4ai.creapulse.fr
LLM_BASE_URL=https://omniroute.creapulse.fr/api/v1
LLM_MODEL=openai/gpt-5.4-mini
LLM_TEMPERATURE=0.2

# --- Identité WordPress (jeton signé creapulse-tools) : compte obligatoire ---
WP_TOKEN_SECRET=                                 # = CREAPULSE_TOOLS_TOKEN_SECRET côté WordPress
REQUIRED_LEVELS=                                 # ex. 2,3 : niveaux PMPro exigés (vide = tout membre)
MEMBER_SESSION_TTL_S=3600                        # session outil d'un membre (survit ≤ 1 h à une déconnexion WP)
WP_SITE_PREFIX=https://www.creapulse.fr/         # allowlist des login_url / register_url
WP_BASE_URL=https://www.creapulse.fr             # site du porte-monnaie et de tool-event : staging pour la recette
WP_TOOL_EVENT_URL=                               # vide = <WP_BASE_URL>/wp-json/creapulse-tools/v1/tool-event ; off = désactivé
TOOL_SLUG=voix-de-marque                         # slug déclaré dans WordPress (« Outils déclarés »)

# --- Porte-monnaie de crédits (creapulse-tools 079) : le prix se règle dans wp-admin → Crédits ---
CREAPULSE_CREDITS_SECRET_VOIX=                   # >= 32 caractères, même valeur que côté WordPress (posée par Serge)
CREDITS_TOOL_SLUG=voix                           # slug saisi dans la page « Crédits »
CREDITS_TIER=generation                          # palier débité à chaque génération
CREDITS_TIMEOUT_S=8

# --- Plafonds (en plus des crédits) ---
ACCOUNT_DAILY_CAP=3
GLOBAL_DAILY_CAP=40
IP_RATE_LIMIT_PER_MIN=6

# --- Qualité d'entrée ---
MAX_URLS=5
MIN_WORDS_PER_PAGE=300
MIN_WORDS_TOTAL=600
MAX_WORDS_PER_PAGE=2500
MAX_WORDS_TOTAL=9000

# --- Divers ---
CTA_URL=https://www.creapulse.fr/contact/
PRIVACY_URL=https://www.creapulse.fr/politique-de-confidentialite/
COOKIE_SECURE=true                               # false en local http
TRUST_PROXY_HEADERS=true                         # derrière Traefik/Coolify
DEBUG=false
