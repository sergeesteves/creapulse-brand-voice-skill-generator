# --- Obligatoire ---
SECRET_KEY=change-me-64-random-chars            # signe cookies + magic-links (python -c "import secrets;print(secrets.token_urlsafe(48))")
CRAWL4AI_TOKEN=                                  # = CRAWL4AI_API_TOKEN du crawl4ai Coolify
LLM_API_KEY=                                     # clé API omniroute (dashboard omniroute.creapulse.fr)
PUBLIC_BASE_URL=https://voix.creapulse.fr        # base des liens magic-link

# --- Store (Postgres en prod ; SQLite local par défaut) ---
DATABASE_URL=postgresql://user:pass@host:5432/voice_skill
# DATABASE_URL=sqlite:///./voice-skill.db

# --- Services réutilisés ---
CRAWL4AI_URL=https://crawl4ai.creapulse.fr
LLM_BASE_URL=https://omniroute.creapulse.fr/api/v1
LLM_MODEL=openai/gpt-5.4-mini
LLM_TEMPERATURE=0.2

# --- Email magic-link (si SMTP_HOST vide → mode log, lien en console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Creapulse <no-reply@creapulse.fr>
SMTP_TLS=true

# --- Gating / caps ---
ANON_FREE_GENERATIONS=1
ANON_IP_DAILY_CAP=2
ACCOUNT_DAILY_CAP=3
GLOBAL_DAILY_CAP=40
IP_RATE_LIMIT_PER_MIN=6

# --- Qualité d'entrée ---
MAX_URLS=5
MIN_WORDS_PER_PAGE=300
MIN_WORDS_TOTAL=600
MAX_WORDS_PER_PAGE=2500
MAX_WORDS_TOTAL=9000

# --- Divers ---
CTA_URL=https://www.creapulse.fr/contact/
PRIVACY_URL=https://www.creapulse.fr/politique-de-confidentialite/
COOKIE_SECURE=true                               # false en local http
TRUST_PROXY_HEADERS=true                         # derrière Traefik/Coolify
DEBUG=false
